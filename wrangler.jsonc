{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "live-setlist-app",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-05-22",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
